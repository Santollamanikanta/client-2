# Google Maps Platform Key: Required for maps and address autocomplete
# Get one at https://console.cloud.google.com/google/maps-apis/start
GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Stripe configuration
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Firebase configuration for Messaging
# VAPID Key from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FCM_VAPID_KEY=

# Firebase Service Account JSON string for the backend to send messages
# Get this from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the entire JSON as a single line string
FIREBASE_SERVICE_ACCOUNT=
