{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["homeowner", "provider", "admin"] },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "rating": { "type": "number" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "isOnline": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Available cleaning and maintenance services.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "basePrice": { "type": "number" },
        "iconName": { "type": "string" }
      },
      "required": ["id", "name", "category", "basePrice"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Service requests and their lifecycle.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "providerId": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "assigned", "arriving", "at-location", "in-progress", "completed", "cancelled"] },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "totalPrice": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["online", "cash"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "serviceId", "status", "scheduledAt", "location", "totalPrice", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Messages between customer and provider for a booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookingId", "senderId", "text", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "profiles/{uid}": {
      "schema": "UserProfile",
      "description": "User profile data."
    },
    "services/{serviceId}": {
      "schema": "Service",
      "description": "Available services."
    },
    "bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Booking records."
    },
    "messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages between users."
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications."
    }
  }
}
