rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDATION HELPERS ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['homeowner', 'provider', 'admin'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['customerId', 'serviceId', 'status', 'scheduledAt', 'location', 'totalPrice', 'createdAt', 'updatedAt']) &&
             data.customerId == request.auth.uid &&
             data.status in ['pending', 'assigned', 'arriving', 'at-location', 'in-progress', 'completed', 'cancelled'] &&
             data.totalPrice is number && data.totalPrice >= 0;
    }

    // --- RULES ---

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && isValidUserProfile(incoming());
      allow update: if isOwner(uid) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'phoneNumber', 'address', 'location', 
          'skills', 'isOnline', 'photoURL', 'updatedAt', 'lat', 'lng', 'isPro', 'proJoinedAt'
        ])
      );
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.providerId == request.auth.uid ||
        resource.data.status == 'pending'
      );
      allow create: if isSignedIn() && isValidBooking(incoming());
      allow update: if isSignedIn() && (
        (existing().status == 'pending' && 
         incoming().diff(existing()).affectedKeys().hasOnly(['providerId', 'status', 'updatedAt', 'providerName'])) ||
        ((resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'paymentStatus', 'paymentId']))
      );
    }

    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read, list: if isOwner(resource.data.userId);
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }
  }
}
